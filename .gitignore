# Never publish IPTV credentials, playlist URLs, or generated reports.
*.m3u
*.m3u8
*.csv
*.json
.env*
__pycache__/
.pytest_cache/
.venv/

# Keep the LAN gateway's persistent URL access token local.
.iptv_gateway_token

# Local JetBrains / IntelliJ IDEA project metadata.
.idea/
*.iml

# Generated or private guide files and channel alias overrides
*.xml.gz
epg-aliases.json

# Private admin credential (never commit)
.iptv_admin_password

# Private persisted TV history, SQLite WAL/SHM files, anonymization salt
.iptv_telemetry.sqlite3*
.iptv_telemetry.salt

# Private TV telemetry directory, including DB, WAL, SHM, and identity salt
.iptv_state/

# Three-TV-cabinet provider M3U/EPG credentials, snapshots and secret tokens
.iptv_profiles/
