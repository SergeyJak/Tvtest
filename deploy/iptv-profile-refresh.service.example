[Unit]
Description=HeySmart TV: refresh M3U and EPG for three managed profiles
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=client_911_1
Group=client_911_1
WorkingDirectory=/home/client_911_1/Tvtest
ExecStart=/usr/bin/python3 -u /home/client_911_1/Tvtest/iptv_profile_jobs.py --profiles-dir /home/client_911_1/Tvtest/.iptv_profiles --legacy-playlist /home/client_911_1/Tvtest/forgpt.m3u8 --legacy-token-file /home/client_911_1/Tvtest/.iptv_gateway_token --legacy-epg /home/client_911_1/Tvtest/epg.xml.gz --refresh-m3u
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
UMask=0077

[Install]
WantedBy=multi-user.target
